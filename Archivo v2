local FolderName = "BenHubConfig"
local FileName = FolderName .. "/settings.json"

if isfolder and not isfolder(FolderName) then
    makefolder(FolderName)
end

local function SaveSettings()
    if writefile then
        local dataToSave = {
            SavedFlags = Flags,
            SavedSkillDelay = Config.SkillDelay,
            SavedZenkaiAmount = Config.ZenkaiAmount
        }
        local json = HttpService:JSONEncode(dataToSave)
        writefile(FileName, json)
    end
end

local function LoadSettings()
    if isfile and isfile(FileName) and readfile then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(FileName))
        end)
        if success and result then
            if result.SavedFlags then
                for k, v in pairs(result.SavedFlags) do
                    Flags[k] = v
                end
            end
            if result.SavedSkillDelay then Config.SkillDelay = result.SavedSkillDelay end
            if result.SavedZenkaiAmount then Config.ZenkaiAmount = result.SavedZenkaiAmount end
        end
    end
end

