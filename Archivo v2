local function autoGrabChests(hrp)
    if not Flags.AutoChest then return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("ProximityPrompt") then
            local name = obj.Name:lower()
            for _, lootName in ipairs(LootList) do
                if name:find(lootName) then
                    local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true) or (obj.Parent and obj.Parent:IsA("BasePart") and obj.Parent or nil)
                    if part and (hrp.Position - part.Position).Magnitude < 40 then
                        local prompt = obj:IsA("ProximityPrompt") and obj or part:FindFirstChildWhichIsA("ProximityPrompt", true) or (obj.Parent and obj.Parent:FindFirstChildWhichIsA("ProximityPrompt", true))
                        if prompt then fireproximityprompt(prompt) end
                        pressKey(Enum.KeyCode.F)
                    end
                end
            end
        end
    end
end

-------------------------------------------------
-- ESFERAS DEL DRAGÓN
