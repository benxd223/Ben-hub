local function getDragonBallTarget()
    for _, v in ipairs(workspace:GetDescendants()) do
        local n = v.Name:lower()
        if n:find("star") or n:find("dragon") or n:find("esfera") or n:find("ball") then
            local p = v:IsA("BasePart") and v or v:FindFirstChildWhichIsA("BasePart", true)
            if p then return p, v end
        end
    end
    return nil, nil
end

local function executeUltraFastTP(hrp)
    local targetPart, parentObj = getDragonBallTarget()
    if targetPart then
        hrp.CFrame = targetPart.CFrame + Vector3.new(0, 1.5, 0)
        task.wait(0.05)
        local prompt = (parentObj and parentObj:FindFirstChildWhichIsA("ProximityPrompt", true)) or targetPart:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then fireproximityprompt(prompt) end
        pressKey(Enum.KeyCode.F)
        return true
    else
        for _, pos in ipairs(FixedDragonBallCoords) do
            if not Flags.AutoDragonBalls then break end
            hrp.CFrame = CFrame.new(pos)
            task.wait(0.12)
            local foundPart, foundObj = getDragonBallTarget()
            if foundPart then
                hrp.CFrame = foundPart.CFrame + Vector3.new(0, 1.5, 0)
                task.wait(0.05)
                local prompt = (foundObj and foundObj:FindFirstChildWhichIsA("ProximityPrompt", true)) or foundPart:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then fireproximityprompt(prompt) end
                pressKey(Enum.KeyCode.F)
                return true
            end
        end
    end
    return false
end

