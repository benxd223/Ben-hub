-- BUCLE PRINCIPAL (CON COOLDOWN DE 5.7S Y TRANSICIÓN LIMPIA)
-------------------------------------------------
task.spawn(function()
    local lastBossModel = nil
    while true do
        task.wait(Config.Delay)
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

        -- Prioridad absoluta al Auto Reply para que detecte derrotas sin que la GUI estorbe
        executeAutoReply()

        if hrp then
            autoGrabChests(hrp)

            if Flags.AutoDragonBalls then
                executeUltraFastTP(hrp)
            end

            if Flags.AutoZenkai and ZenkaiCount < Config.ZenkaiAmount then
                for _, parent in ipairs({LocalPlayer.PlayerGui, CoreGui}) do
                    for _, obj in ipairs(parent:GetDescendants()) do
                        if (obj:IsA("TextButton") or obj:IsA("ImageButton")) and obj.Visible then
                            local text = (obj:IsA("TextButton") and obj.Text or ""):lower()
                            local name = obj.Name:lower()
                            if text:find("zenkai") or name:find("zenkai") or text:find("rebirth") or text:find("rebirth") or text:find("renacer") then
                                forceClick(obj)
                                ZenkaiCount = ZenkaiCount + 1
                                task.wait(1)
                                if ZenkaiCount >= Config.ZenkaiAmount then Flags.AutoZenkai = false end
                                break
                            end
                        end
                    end
                end
            end

            local currentTargetList = nil
            if Flags.AutoZeni then currentTargetList = ZeniBossList
            elseif Flags.AutoFarmBoss then currentTargetList = BossList end

            if currentTargetList then
                local bossPart = nil
                local foundModel = nil
                for _, v in ipairs(workspace:GetDescendants()) do
                    if v:IsA("Model") then
                        local name = v.Name:lower()
                        for _, t in ipairs(currentTargetList) do
                            if name:find(t) then
                                local hum = v:FindFirstChildOfClass("Humanoid")
                                if hum and hum.Health > 0 then 
                                    bossPart = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Torso") or v:FindFirstChild("UpperTorso")
                                    foundModel = v
                                    break 
                                end
                            end
                        end
                    end
                    if bossPart then break end
                end
                
                if bossPart and foundModel then
                    if lastBossModel ~= foundModel then
                        task.wait(0.5)
                        pressKey(Enum.KeyCode.B)
                        task.wait(1.5)
                        lastBossModel = foundModel
                    end
                    
                    hrp.CFrame = bossPart.CFrame * CFrame.new(0, 0, 3)
                    
                    if Flags.AutoLockBoss then pressKey(Enum.KeyCode.F) end
                    if Flags.AutoClick then pressKey(Enum.KeyCode.E); clickMouse() end
                else
                    if lastBossModel ~= nil then
                        task.wait(5.7)
                        lastBossModel = nil
                    end
                end
            end
        end
    end
end)

